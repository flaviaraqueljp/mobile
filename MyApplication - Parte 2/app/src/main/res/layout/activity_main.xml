<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/logoImage"
        android:src="@drawable/instituicao"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:contentDescription="@string/desc_logo_inst"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/inst_name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/course_name"
        android:textSize="18sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/course_desc"
        android:layout_marginTop="8dp"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnSobreCurso"
        android:layout_width="wrap_content"
        android:minWidth="250dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_about_course"
        android:layout_marginTop="24dp"/>

    <Button
        android:id="@+id/btnDisciplinas"
        android:layout_width="wrap_content"
        android:minWidth="250dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_disciplines"
        android:layout_marginTop="8dp"/>
</LinearLayout>
